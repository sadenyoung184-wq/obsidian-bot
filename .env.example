# ===== ۱) تلگرام =====
TELEGRAM_TOKEN=PASTE_TELEGRAM_TOKEN
ALLOWED_USER_IDS=PASTE_NUMERIC_ID

# ===== ۲) Gemini =====
GEMINI_API_KEY=PASTE_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash-latest

# ===== ۳) والت =====
# روی لپ‌تاپ ویندوزی: E:/my-vault (با اسلش)
# روی هاست Render: ./MyVault
VAULT_PATH=E:/my-vault
TIMEZONE=Asia/Tehran

# ===== ۴) سینک گیت (برای هاست ابری true، روی لپ‌تاپ false) =====
GIT_SYNC_ENABLED=false
GIT_REPO_URL=PASTE_VAULT_REPO_URL
GIT_BRANCH=main
